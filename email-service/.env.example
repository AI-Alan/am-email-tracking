# Cosmos DB Configuration
COSMOS_URI=https://your-cosmos-account.documents.azure.com:443/
COSMOS_KEY=your-cosmos-key-here
COSMOS_DATABASE_REALTOR_MANAGEMENT=RealtorManagementDB(realtor_and_above_access)
COSMOS_CONTAINER_EMAIL=trackingData

# Microsoft Graph API for Emails
CLIENT_ID=your-client-id
TENANT_ID=your-tenant-id
CLIENT_SECRET=your-client-secret
SENDER_EMAIL=your-email@domain.com

# Webhook URL for Graph subscriptions
WEBHOOK_URL=https://your-email-service.onrender.com/graph/webhook

# Tracking Service URL (for tracking pixel)
TRACKING_SERVICE_URL=https://your-tracking-service.onrender.com
